# ── TeleCode bridge configuration ──────────────────────────────
# Copy this file to .env and fill in your own values.
# Easiest way: run `npm run setup` for an interactive wizard.

# Telegram bot token from @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=123456:your-bot-token-from-botfather

# Your numeric Telegram user id — only this user can talk to the bridge.
# Leave EMPTY to auto-pair: the first person who messages the bot (you, by
# tapping Start) becomes the owner and is saved automatically.
# Or set it explicitly with your id from @userinfobot.
TELEGRAM_OWNER_ID=

# The project/workspace opencode should operate on.
# Use an absolute path. Examples:
#   Linux/macOS:  /home/you/projects/my-app
#   Windows:      C:\Users\you\projects\my-app
WORKSPACE_DIR=

# opencode server connection (defaults are fine for local use).
OPENCODE_HOST=127.0.0.1
OPENCODE_PORT=4096

# Optional: path to a specific opencode binary. Set this if the `opencode` on
# your PATH isn't the version this bridge targets (opencode 1.x). Leave empty
# to use `opencode` from PATH.
OPENCODE_BIN=

# Optional: password for the opencode server (Basic auth).
# Leave empty to run without authentication on localhost.
OPENCODE_SERVER_PASSWORD=

# Optional: voice notes → text. Set STT_API_KEY to enable transcription.
# Works with any OpenAI-compatible /audio/transcriptions endpoint.
STT_API_KEY=
STT_API_URL=https://api.openai.com/v1/audio/transcriptions
STT_MODEL=whisper-1
